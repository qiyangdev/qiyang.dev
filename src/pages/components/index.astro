---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const components = (
  await getCollection("components", ({ data }) => !data.draft)
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Components | ${config.site.title}`}
  description="A collection of components and examples."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Components"
    pageDesc="A collection of components and examples."
  >
    <ul>
      {
        components.map(component => (
          <li class="my-6">
            <a
              class="text-accent text-lg font-medium underline-offset-4 hover:underline"
              href={getRelativeLocaleUrl(locale, `components/${component.id}`)}
            >
              {component.data.title}
            </a>
            <p>{component.data.description}</p>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>

---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

export async function getStaticPaths() {
  const components = await getCollection(
    "components",
    ({ data }) => !data.draft
  );
  return components.map(component => ({
    params: { slug: component.id },
    props: { component },
  }));
}

interface Props {
  component: CollectionEntry<"components">;
}
const { component } = Astro.props;
const { Content } = await render(component);
---

<Layout
  title={`${component.data.title} | ${config.site.title}`}
  description={component.data.description}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-4" data-pagefind-body>
    <h1 class="text-2xl font-semibold sm:text-3xl">{component.data.title}</h1>
    <article class="app-prose max-w-app mt-8 w-full">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>
